PORT=8001

# Comma-separated allowed origins for frontend
# Example:
# CORS_ORIGIN=https://your-vercel-site.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

CONTACT_TO_EMAIL=you@example.com

# Render free tier blocks outbound SMTP (ports 587/465). Use Resend on production:
# https://resend.com - API key + verify domain (or use onboarding@resend.dev for testing).
RESEND_API_KEY=
RESEND_FROM=Portfolio Contact <onboarding@resend.dev>

# SMTP - works locally; blocked on Render free plan
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
