PORT=8001

# Comma-separated allowed origins for frontend
# Example:
# CORS_ORIGIN=https://your-vercel-site.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional MongoDB URI. If empty, backend stores contacts in memory only.
MONGODB_URI=

# SMTP settings (optional, but needed to email contact notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO_EMAIL=hoangkhoa.nguyentan@gmail.com
